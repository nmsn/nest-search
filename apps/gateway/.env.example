# =============================================================
# gateway .env.example — 复制为 apps/gateway/.env 并按需修改
# 字段说明见 docs/CONFIG.md
# 启动时 Zod 校验(env.schema.ts),env 缺失/类型错会 fail-fast
# =============================================================

# ---------- 公共字段(其他 4 service 也有,详见 docs/CONFIG.md) ----------
NODE_ENV=development                  # development / test / production
LOG_LEVEL=info                       # error / warn / info / debug
JWT_SECRET=change-me-to-something-secure-at-least-16-chars
                                     # 必填,生产必须用 openssl rand -hex 32 生成
JWT_EXPIRES_IN=2h
CAS_COOKIE_DOMAIN=.example.local     # CAS 单点登录 cookie 域
CAS_TGT_EXPIRES_IN=8h               # CAS ticket-granting ticket 过期时间
CAS_ST_EXPIRES_IN=30s               # CAS service ticket 过期时间

# ---------- gateway 私有字段 ----------
GATEWAY_PORT=3000                    # 网关自身监听端口

# 3 个业务线 API key(gateway 用来鉴权前端请求)
API_KEY_DS=ds_key_123
API_KEY_ZK=zk_key_456
API_KEY_MEETING=meeting_key_789

# 4 个下游 service URL(gateway 代理请求到这些)
AUTH_SERVICE_URL=http://localhost:3004
SEARCH_SERVICE_URL=http://localhost:3002
SYNC_SERVICE_URL=http://localhost:3001
FORM_SERVICE_URL=http://localhost:3003

# refresh token 过期时间(秒),给 auth 代理用
REFRESH_TOKEN_EXPIRES_IN=604800      # 默认 7 天

# MQ(gateway 当前不用,但 sync 启动会校验)
