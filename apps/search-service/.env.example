# =============================================================
# search-service .env.example — 复制为 apps/search-service/.env
# 字段说明见 docs/CONFIG.md
# 启动时 Zod 校验(env.schema.ts)
# =============================================================

# ---------- 公共字段 ----------
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=change-me-to-something-secure-at-least-16-chars
JWT_EXPIRES_IN=2h
CAS_COOKIE_DOMAIN=.example.local
CAS_TGT_EXPIRES_IN=8h
CAS_ST_EXPIRES_IN=30s

# ---------- search-service 私有字段 ----------
SEARCH_SERVICE_PORT=3002            # search 自身端口

# Elasticsearch(产品索引)
ELASTICSEARCH_NODE=http://localhost:9200

# MQ(sync-service 通过它推送索引更新)
