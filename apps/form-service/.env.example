# =============================================================
# form-service .env.example — 复制为 apps/form-service/.env
# 字段说明见 docs/CONFIG.md
# 启动时 Zod 校验(env.schema.ts)
# =============================================================

# ---------- 公共字段 ----------
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=change-me-to-something-secure-at-least-16-chars
JWT_EXPIRES_IN=2h
CAS_COOKIE_DOMAIN=.example.local
CAS_TGT_EXPIRES_IN=8h
CAS_ST_EXPIRES_IN=30s

# ---------- form-service 私有字段 ----------
FORM_SERVICE_PORT=3003              # form 自身端口

# MySQL(表单数据表)
DATABASE_URL=mysql://root:root123@localhost:3306/nest_search

# MQ(form 通过 RabbitMQ 接收提交通知)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
