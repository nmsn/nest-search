# =============================================================
# auth-service .env.example — 复制为 apps/auth-service/.env
# 字段说明见 docs/CONFIG.md
# 启动时 Zod 校验(env.schema.ts)
# =============================================================

# ---------- 公共字段 ----------
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=change-me-to-something-secure-at-least-16-chars
JWT_EXPIRES_IN=2h
CAS_COOKIE_DOMAIN=.example.local
CAS_TGT_EXPIRES_IN=8h
CAS_ST_EXPIRES_IN=30s

# ---------- auth-service 私有字段 ----------
AUTH_SERVICE_PORT=3004               # auth 自身端口

# MySQL(用户表 / cas 服务表)
DATABASE_URL=mysql://root:root123@localhost:3306/nest_search

# Redis(refresh token 缓存)
REDIS_HOST=localhost
REDIS_PORT=6379

# refresh token 过期时间(秒)
REFRESH_TOKEN_EXPIRES_IN=604800      # 默认 7 天
