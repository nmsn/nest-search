# =============================================================
# sync-service .env.example — 复制为 apps/sync-service/.env
# 字段说明见 docs/CONFIG.md
# 启动时 Zod 校验(env.schema.ts)
# =============================================================

# ---------- 公共字段 ----------
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=change-me-to-something-secure-at-least-16-chars
JWT_EXPIRES_IN=2h
CAS_COOKIE_DOMAIN=.example.local
CAS_TGT_EXPIRES_IN=8h
CAS_ST_EXPIRES_IN=30s

# ---------- sync-service 私有字段 ----------
SYNC_SERVICE_PORT=3001              # sync 自身端口

# MySQL(同步任务记录表)
DATABASE_URL=mysql://root:root123@localhost:3306/nest_search

# Elasticsearch(sync 写索引到这里)
ELASTICSEARCH_NODE=http://localhost:9200

# MQ(sync 消费 RabbitMQ 触发同步)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
