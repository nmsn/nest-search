# PostgreSQL(2026-06-24 从 MySQL 迁)
# 真实密码不放 git;.env 本地有,密码由 docker-compose 默认或 secrets 管理
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/nest_search

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# RabbitMQ
RABBITMQ_URL=amqp://guest:CHANGE_ME@localhost:5672

# API Keys (per business line)
API_KEY_DS=CHANGE_ME
API_KEY_ZK=CHANGE_ME
API_KEY_MEETING=CHANGE_ME

# Service Ports
GATEWAY_PORT=3000
SYNC_SERVICE_PORT=3001
SEARCH_SERVICE_PORT=3002
FORM_SERVICE_PORT=3003

# Auth Service
AUTH_SERVICE_PORT=3004
JWT_SECRET=CHANGE_ME_min_16_chars
JWT_EXPIRES_IN=2h
CAS_TGT_EXPIRES_IN=8h
CAS_ST_EXPIRES_IN=30s
CAS_COOKIE_DOMAIN=.example.local

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REFRESH_TOKEN_EXPIRES_IN=604800
