{
  "compilerOptions": {
    "composite": true,
    "module": "commonjs",
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "skipLibCheck": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "incremental": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "apps/**/src/**/*",
    "libs/shared/src/**/*",
    "libs/frontend-shared/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/test/**",
    "**/tests/**"
  ]
}